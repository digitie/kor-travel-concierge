{
  "name": "kor-travel-concierge-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:live": "next dev --hostname 127.0.0.1 --port 12605",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:dependencies": "node node_modules/@kor-travel/ui/check-dependencies.mjs --lock package-lock.json --workspace \"\" --artifacts common-artifacts.json --source src && node scripts/check-common-ui.mjs",
    "doctor": "react-doctor --scope full --no-score --no-telemetry --blocking warning .",
    "doctor:audit": "react-doctor --scope full --no-score --no-telemetry --no-respect-inline-disables --blocking warning ."
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@kor-travel/tokens": "file:vendor/kor-travel-tokens-0.1.1.tgz",
    "@kor-travel/ui": "file:vendor/kor-travel-ui-0.2.0.tgz",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "maplibre-gl": "6.17.0",
    "next": "16.4.6",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "3.7.0",
    "vworld-map-core": "file:vendor/vworld-map-core-1.0.1.tgz",
    "vworld-map-web": "file:vendor/vworld-map-web-1.0.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.32",
    "react-doctor": "0.9.22",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
