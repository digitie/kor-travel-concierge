# Kor Travel Concierge Python 서비스 공용 이미지 (초안)
# api / mcp / scheduler / etl 가 동일 이미지를 공유하고, compose에서 command로 분기한다.
FROM python:3.11-slim AS runtime

# FFmpeg(대표 프레임 추출) 시스템 의존성
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        ca-certificates \
        git \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 의존성 레이어 캐싱: 매니페스트 먼저 복사
COPY backend/requirements.txt backend/requirements.txt
COPY etl/requirements.txt etl/requirements.txt
COPY scheduler/requirements.txt scheduler/requirements.txt
COPY mcp/requirements.txt mcp/requirements.txt
RUN pip install --no-cache-dir \
    -r backend/requirements.txt \
    -r etl/requirements.txt \
    -r scheduler/requirements.txt \
    -r mcp/requirements.txt

# 애플리케이션 소스
COPY alembic.ini alembic.ini
COPY backend backend
COPY etl etl
COPY scheduler scheduler
COPY mcp mcp
COPY scripts scripts

# `ktc` 패키지(backend/ktc)와 실행 래퍼/서비스 패키지를 import 가능하게 한다.
ENV PYTHONPATH=/app:/app/backend
ENV PYTHONUNBUFFERED=1
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV FFPROBE_PATH=/usr/bin/ffprobe

# 기본 command는 compose에서 서비스별로 재정의한다.
WORKDIR /app/backend
CMD ["python", "-m", "ktc.cli", "api"]


# Dagster는 이 target에만 설치한다. 기본 최종 api target에는 family가 없다.
FROM runtime AS dagster
COPY dagster/requirements.txt /app/dagster/requirements.txt
RUN pip install --no-cache-dir -r /app/dagster/requirements.txt \
    && useradd --uid 10001 --create-home concierge \
    && mkdir -p /opt/dagster/dagster_home /opt/dagster/state/artifacts /opt/dagster/state/compute_logs \
    && chown -R concierge:concierge /opt/dagster
ENV DAGSTER_GRPC_PROXY_HEARTBEAT_TTL_SECONDS=600
ENV DAGSTER_HOME=/opt/dagster/dagster_home
USER concierge
WORKDIR /app
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
    CMD python -I -m kortravelcommon.dagster_health 12603
CMD ["dagster", "code-server", "start", "-h", "0.0.0.0", "-p", "12603", "-m", "ktc.dagster.definitions"]

FROM runtime AS api
